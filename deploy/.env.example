# Copy to deploy/.env and fill every value. Never commit deploy/.env.
SSO_IMAGE=sso-service:0.1.0
SSO_DOMAIN=sso.example.com

POSTGRES_USER=sso
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sso
REDIS_PASSWORD=change-me

APP_ENV=production
HTTP_ADDR=:8080
EXTERNAL_URL=https://sso.example.com
DATABASE_URL=postgres://sso:change-me@postgres:5432/sso?sslmode=disable
REDIS_URL=redis://:change-me@redis:6379/0
SSO_MASTER_KEYS={"2026-11":"replace-with-32-byte-base64"}
SSO_MASTER_KEY_ID=2026-11
# Docker network CIDR that contains Caddy. Without this, every request looks
# like it came from the proxy IP.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
ALLOWED_ORIGINS=https://sso.example.com
PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_IP_LIMIT=10
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_IP_LIMIT=600
API_IP_LIMIT=3000
OIDC_IP_LIMIT=600
TOKEN_CLIENT_LIMIT=6000
ARGON2_CONCURRENCY=2
LOG_LEVEL=info
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_TLS=true
