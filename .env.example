# Copy to .env and adjust for local development.
# The values below are DEV ONLY. Never reuse them outside a laptop.

APP_ENV=dev
HTTP_ADDR=:8080
EXTERNAL_URL=http://localhost:8080
LOG_LEVEL=debug
METRICS_ADDR=:9090

# Ports match docker-compose.yml. Change these in .env if a host port is busy,
# then update DATABASE_URL and REDIS_URL to the same values.
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=8080
CADDY_PORT=8088

# Ports match docker-compose.yml.
DATABASE_URL=postgres://sso:dev-only-postgres@localhost:5432/sso?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# DEV ONLY master keyring: one base64-encoded 32-byte AES-256 key.
# Generate a production keyring with:
#   openssl rand -base64 32
SSO_MASTER_KEYS={"dev-only":"FglevJnTk5aiM1Gmb5Epn2V6wQ1e5ZvxYHUNMBGp/sA="}
SSO_MASTER_KEY_ID=dev-only

# Browser origins allowed to call the auth endpoints. When empty this defaults
# to EXTERNAL_URL, plus http://localhost:5173 in dev.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
PASSWORD_MIN_LENGTH=12
# Login attempts per IP per minute. Raise for local load tests only.
AUTH_LOGIN_IP_LIMIT=10

# MailHog for development. Leave SMTP_HOST empty for Compose, which substitutes
# the mailhog service name; a direct `go run ./cmd/server` falls back to
# localhost. SMTP_TLS=false means plain SMTP; production should set a real host
# and true to require STARTTLS.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false

# Leave empty when the app is exposed directly. Set this to the proxy network
# when Caddy or another reverse proxy forwards requests.
TRUSTED_PROXY_CIDRS=
