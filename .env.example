# Copy to .env and adjust for local development.
# The values below are DEV ONLY. Never reuse them outside a laptop.

APP_ENV=dev
HTTP_ADDR=:8080
EXTERNAL_URL=http://localhost:8080
LOG_LEVEL=debug
METRICS_ADDR=:9090

# Ports match docker-compose.yml.
DATABASE_URL=postgres://sso:dev-only-postgres@localhost:5432/sso?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# DEV ONLY master keyring: one base64-encoded 32-byte AES-256 key.
# Generate a production keyring with:
#   openssl rand -base64 32
SSO_MASTER_KEYS={"dev-only":"FglevJnTk5aiM1Gmb5Epn2V6wQ1e5ZvxYHUNMBGp/sA="}
SSO_MASTER_KEY_ID=dev-only

# Leave empty when the app is exposed directly. Set this to the proxy network
# when Caddy or another reverse proxy forwards requests.
TRUSTED_PROXY_CIDRS=
